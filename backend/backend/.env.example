# ========================================================
# Devpilot Backend Environment Variables
# ========================================================

# Server Port (Render sets this dynamically)
PORT=8080

# Database Configuration (PostgreSQL with pgvector)
# For local Docker:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/DEVPILOT
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# For Render / Cloud Hosted Database:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<dbname>
# SPRING_DATASOURCE_USERNAME=<db_user>
# SPRING_DATASOURCE_PASSWORD=<db_password>

# Google Gemini AI API Key (Get at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub OAuth App Credentials (Create at: https://github.com/settings/developers)
# Local Authorization callback URL: http://localhost:8080/login/oauth2/code/github
# Production callback URL: https://<your-render-backend-domain>/login/oauth2/code/github
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Frontend URL & CORS Configuration
# Local development:
# Frontend URL & CORS Configuration (Configured for your Vercel deployment)
FRONTEND_URL=https://ask-my-repo-mu.vercel.app
CORS_ALLOWED_ORIGINS=https://ask-my-repo-mu.vercel.app,http://localhost:3000

# Token Encryption Keys (AES encryption for storing GitHub access tokens in PostgreSQL)
TOKEN_ENCRYPTOR_PASSWORD=devpilot-prod-encrypt-9a4f82e1c7b3408a9d6e5218c39e
TOKEN_ENCRYPTOR_SALT=deadbeefcafebabe

# Session Cookie Settings for Production (HTTPS Cross-Domain Vercel <-> Render)
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
