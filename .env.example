# ========================================================
# Devpilot Environment Configuration (.env.example)
# ========================================================

# --------------------------------------------------------
# 1. BACKEND & RENDER ENVIRONMENT VARIABLES
# --------------------------------------------------------
PORT=8080

# Database (PostgreSQL with pgvector)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/DEVPILOT
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# AI Services (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub OAuth App
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Frontend & CORS (Configured for Vercel)
FRONTEND_URL=https://ask-my-repo-mu.vercel.app
CORS_ALLOWED_ORIGINS=https://ask-my-repo-mu.vercel.app,http://localhost:3000

# Security & Token Encryption (AES-256 for GitHub Tokens)
TOKEN_ENCRYPTOR_PASSWORD=devpilot-prod-encrypt-9a4f82e1c7b3408a9d6e5218c39e
TOKEN_ENCRYPTOR_SALT=deadbeefcafebabe

# Session Cookie (Required for cross-domain Vercel <-> Render HTTPS authentication)
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

# --------------------------------------------------------
# 2. FRONTEND (NEXT.JS) ENVIRONMENT VARIABLES
# --------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
